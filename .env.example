WHATSAPP_PHONE_NUMBER_ID=pegar-id-del-numero-de-whatsapp
WHATSAPP_API_VERSION=v23.0

# Protege el futuro envío manual desde la bandeja administrativa
ADMIN_API_KEY=cambiar-por-clave-secreta

# IA opcional
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# PIN para comandos /tomar, /bot y /cerrar durante pruebas
ADMIN_CONTROL_PIN=2416
# Protege las rutas administrativas de la futura bandeja
ADMIN_API_KEY=cambiar-por-una-clave-segura

# Integración futura DigitalClub (solo lectura)
DIGITALCLUB_API_URL=
DIGITALCLUB_API_KEY=
